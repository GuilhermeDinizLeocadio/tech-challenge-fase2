# ============================================================
# CREDENCIAIS AWS ACADEMY
# Copie este arquivo para .env e preencha com suas credenciais
# Obtenha as credenciais em: AWS Academy → Learner Lab → AWS Details
# ============================================================

# Credenciais temporárias da AWS Academy (expiram por sessão)
AWS_ACCESS_KEY_ID=cole_sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=cole_sua_secret_key_aqui
AWS_SESSION_TOKEN=cole_seu_session_token_aqui

# Configurações fixas do projeto 
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=tech-challenge-alfabetizacao